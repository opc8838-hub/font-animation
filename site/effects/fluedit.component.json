      "scope": "effect",
      "name": {
        "zh": "色谱偏移",
        "en": "Color offset"
      },
      "type": "number"
    },
    {
      "path": "scene.stops[].color",
      "scope": "effect",
      "name": {
        "zh": "色标颜色",
        "en": "Stop color"
      },
      "type": "color"
    },
    {
