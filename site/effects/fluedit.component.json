{
  "effect": {
    "id": "fluedit",
    "name": {
      "zh": "流彩",
      "en": "Fluedit"
    },
    "version": "1.0.0",
    "category": "graphic"
  },
  "runtime": {
    "kind": "iframe-bridge",
    "entry": "fluedit/?v=20261023-standard1",
    "bridgeVersion": "1.0.0",
    "renderer": "webgl2-color-field"
  },
  "capabilities": {
    "preview": true,
    "liveEditorState": true,
    "organicShapes": true,
    "colorStops": true,
    "localColorAreas": true,
    "timeline": true,
    "responsiveCanvas": true,
    "exports": [
      "png",
      "gif",
      "mp4"
    ]
  },
  "behavior": {
    "summary": {
      "zh": "固定有机轮廓内的色谱连续流动，叠加可调的色谱偏移和色域呼吸。scene 是当前作品的完整状态，documents 保留其他已编辑形状。编辑区衬底不进入作品。",
      "en": "Colors flow within a fixed organic silhouette with optional color shift and spread. The scene contains the complete current artwork; documents retain other edited shapes. The editor stage backdrop is presentation only."
    },
    "phases": [
      {
        "id": "flow",
        "name": {
          "zh": "色彩流动",
          "en": "Color flow"
        },
        "colorToken": "phase.violet"
      },
      {
        "id": "shift",
        "name": {
          "zh": "色谱偏移",
          "en": "Color shift"
        },
        "colorToken": "phase.coral"
      },
      {
        "id": "spread",
        "name": {
          "zh": "色域呼吸",
          "en": "Color spread"
        },
        "colorToken": "phase.sky"
      }
    ]
  },
  "parameters": [
    {
      "path": "canvas.width",
      "scope": "global",
      "name": {
        "zh": "画布宽度",
        "en": "Canvas width"
      },
      "type": "number"
    },
    {
      "path": "canvas.height",
      "scope": "global",
      "name": {
        "zh": "画布高度",
        "en": "Canvas height"
      },
      "type": "number"
    },
    {
      "path": "canvas.fps",
      "scope": "global",
      "name": {
        "zh": "帧率",
        "en": "Frame rate"
      },
      "type": "number"
    },
    {
      "path": "settings.duration",
      "scope": "global",
      "name": {
        "zh": "导出时长模式",
        "en": "Duration mode"
      },
      "type": "enum"
    },
    {
      "path": "settings.seconds",
      "scope": "global",
      "name": {
        "zh": "自定义秒数",
        "en": "Custom seconds"
      },
      "type": "number"
    },
    {
      "path": "settings.scale",
      "scope": "global",
      "name": {
        "zh": "输出比例",
        "en": "Export scale"
      },
      "type": "number"
    },
    {
      "path": "scene.shape",
      "scope": "effect",
      "name": {
        "zh": "有机形状",
        "en": "Organic shape"
      },
      "type": "enum"
    },
    {
      "path": "scene.background",
      "scope": "effect",
      "name": {
        "zh": "作品背景",
        "en": "Artwork background"
      },
      "type": "color"
    },
    {
      "path": "scene.field.spread",
      "scope": "effect",
      "name": {
        "zh": "色域范围",
        "en": "Color spread"
      },
      "type": "number"
    },
    {
