{
  "effect": {
    "id": "curvedgallery",
    "name": {
      "zh": "弧廊归标",
      "en": "Curved Gallery"
    },
    "version": "1.0.0",
    "category": "media"
  },
  "runtime": {
    "kind": "iframe-bridge",
    "entry": "curvedgallery.html?preview=1&embed=1&v=20261010-ai1",
    "bridgeVersion": "1.0.0",
    "renderer": "canvas2d-webgl-textures"
  },
  "capabilities": {
    "editableBrandText": true,
    "customImageAssets": true,
    "animatedImageAssets": true,
    "sharedIcons": true,
    "imageCrop": true,
    "imageEffects": true,
    "timeline": true,
    "responsiveCanvas": true,
    "exports": [
      "png",
      "gif",
      "mp4"
    ],
    "preview": true
  },
  "behavior": {
    "summary": {
      "zh": "完整图片沿弧面旋转，后退缩小并压成细条，始终保留图片颜色；组合向左移动，右侧品牌文字逐字揭开。每张图独立保留裁切、外观和视差参数。",
      "en": "Intact curved pictures rotate, retreat, shrink and narrow into colored strips; the group moves left as brand text rises letter by letter. Every stable image retains its crop, look and parallax settings."
    },
    "phases": [
      {
        "id": "rotate",
        "name": {
          "zh": "环形转动",
          "en": "Rotate"
        },
        "colorToken": "phase.sky"
      },
      {
        "id": "pullback",
        "name": {
          "zh": "压弯聚拢",
          "en": "Fold / pull back"
        },
        "colorToken": "phase.violet"
      },
      {
        "id": "markHold",
        "name": {
          "zh": "标志停留",
          "en": "Mark hold"
        },
        "colorToken": "phase.mint"
      },
      {
        "id": "shift",
        "name": {
          "zh": "整组左移",
          "en": "Move left"
        },
        "colorToken": "phase.mint"
      },
      {
        "id": "reveal",
        "name": {
          "zh": "文字揭开",
          "en": "Word reveal"
        },
        "colorToken": "phase.coral"
      },
      {
        "id": "hold",
        "name": {
          "zh": "组合停留",
          "en": "Lockup hold"
        },
        "colorToken": "phase.amber"
      },
      {
        "id": "fade",
        "name": {
          "zh": "淡出",
          "en": "Fade"
        },
        "colorToken": "phase.lime"
      }
    ]
  },
