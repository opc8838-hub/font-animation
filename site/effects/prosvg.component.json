{
  "effect": {
    "id": "prosvg",
    "name": {
      "zh": "彩铸",
      "en": "PRO SVG Lab"
    },
    "version": "1.0.0",
    "category": "kinetic-typography"
  },
  "runtime": {
    "kind": "iframe-bridge",
    "entry": "prosvg.html?preview=1&embed=1",
    "bridgeVersion": "1.0.0",
    "renderer": "svg-canvas2d"
  },
  "capabilities": {
    "editableTextRows": true,
    "rowFonts": true,
    "inlineIcons": true,
    "customImageAssets": true,
    "localBackgroundRemoval": true,
    "rowBackgrounds": [
      "color",
      "image",
      "gif",
      "video"
    ],
    "videoTrim": true,
    "timeline": true,
    "responsiveCanvas": true,
    "exports": [
      "png",
      "gif",
      "mp4",
      "svg"
    ]
  },
  "behavior": {
    "summary": {
      "zh": "固定字形上的灰度扫描与流动色谱。材质实现来自 Johnlzx，视觉原作来自 Mike Bespalov / Refero；CellMotion 提供编辑器与导出扩展。",
      "en": "Grayscale scanning and flowing color on fixed glyphs. Material by Johnlzx; visual original by Mike Bespalov / Refero. CellMotion adds editing and export."
    },
    "phases": [
      {
        "id": "intro",
        "name": {
          "zh": "柔和揭示",
          "en": "Soft reveal"
        },
        "colorToken": "phase.intro"
      },
      {
        "id": "flow",
        "name": {
          "zh": "色谱流动",
          "en": "Material flow"
        },
        "colorToken": "phase.hold"
      }
    ]
  },
  "parameters": [
    {
      "path": "composition.canvas.width",
      "scope": "global",
      "type": "integer",
      "unit": "px",
      "minimum": 320,
      "maximum": 3840,
      "name": {
        "zh": "画布宽度",
        "en": "Canvas width"
      }
    },
    {
      "path": "composition.canvas.height",
      "scope": "global",
      "type": "integer",
      "unit": "px",
      "minimum": 320,
      "maximum": 3840,
      "name": {
        "zh": "画布高度",
        "en": "Canvas height"
      }
    },
    {
      "path": "composition.motion.speed",
      "scope": "global",
      "type": "number",
      "unit": "x",
      "minimum": 0.1,
      "maximum": 4,
      "name": {
        "zh": "播放速度",
        "en": "Playback speed"
      }
    },
    {
      "path": "composition.rows[].text",
      "scope": "row",
      "type": "string",
      "name": {
        "zh": "段落文字",
        "en": "Row text"
      }
    },
    {
      "path": "composition.rows[].hold",
      "scope": "row",
      "type": "number",
      "unit": "ms",
      "minimum": 0,
      "maximum": 10000,
      "name": {
        "zh": "段落停留",
        "en": "Row hold"
      }
    },
    {
      "path": "composition.material.blur",
      "scope": "effect",
      "type": "number",
      "minimum": 0,
      "maximum": 16,
      "name": {
        "zh": "柔度",
        "en": "Softness"
      }
    },
    {
      "path": "composition.material.grain",
      "scope": "effect",
      "type": "number",
      "minimum": 0,
      "maximum": 0.4,
      "name": {
        "zh": "颗粒",
        "en": "Grain"
      }
    },
    {
      "path": "composition.material.period",
      "scope": "effect",
      "type": "number",
      "minimum": 1,
      "maximum": 12,
      "name": {
        "zh": "扫描周期",
        "en": "Scan period"
      }
    },
    {
      "path": "composition.material.warp",
      "scope": "effect",
      "type": "number",
      "minimum": 0,
      "maximum": 24,
      "name": {
        "zh": "流体置换",
        "en": "Displacement"
      }
    },
    {
      "path": "composition.material.light",
      "scope": "effect",
      "type": "number",
      "minimum": 0,
      "maximum": 2,
      "name": {
        "zh": "浮雕高光",
        "en": "Specular light"
      }
    },
    {
      "path": "composition.material.palette",
      "scope": "effect",
      "type": "string",
      "enum": [
        "original",
        "silver",
        "lava",
        "violet"
      ],
      "name": {
        "zh": "色谱",
        "en": "Palette"
      }
    }
  ]
}
