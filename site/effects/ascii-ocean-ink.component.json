  "behavior": {
    "summary": {
      "zh": "love from 手写停留一秒后，墨丝在海水中缓慢扩散",
      "en": "Smaller handwritten love from holds for one second, then slowly disperses into the ocean as curling ink filaments."
    },
    "phases": [
      {
        "id": "lead",
        "name": {
          "zh": "海洋开场",
          "en": "Ocean opening"
        },
        "colorToken": "phase.sky"
      },
      {
        "id": "write",
        "name": {
          "zh": "手写落墨",
          "en": "Ink handwriting"
        },
        "colorToken": "phase.violet"
      },
      {
        "id": "hold",
        "name": {
          "zh": "写完停留",
          "en": "Written hold"
        },
        "colorToken": "phase.amber"
      },
      {
        "id": "dissolve",
        "name": {
          "zh": "融墨入海",
          "en": "Ink into water"
        },
        "colorToken": "phase.mint"
      },
      {
        "id": "swim",
        "name": {
          "zh": "海洋巡游",
          "en": "Ocean cruise"
        },
        "colorToken": "phase.sky"
      }
    ]
  },
