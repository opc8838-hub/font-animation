{
  "effect": {
    "id": "patentcount",
    "name": {
      "zh": "作品展示 2",
      "en": "Artwork Showcase 2"
    },
    "version": "1.1.0",
    "category": "media-motion"
  },
  "runtime": {
    "kind": "iframe-bridge",
    "entry": "patentcount.html?preview=1&embed=1&v=20261019-review2",
    "bridgeVersion": "1.0.0",
    "renderer": "canvas2d"
  },
  "capabilities": {
    "compositionModel": "media",
    "timeline": true,
    "responsiveCanvas": true,
    "exports": [
      "png",
      "gif",
      "mp4"
    ],
    "customImageAssets": true,
    "backgrounds": [
      "color",
      "image",
      "gif",
      "video"
    ],
    "videoTrim": true
  },
  "behavior": {
    "summary": {
      "zh": "主作品拉远，Mutedmen 作品汇成弧形墙，自定义标题与图片数量逐步显现。",
      "en": "The hero pulls back into an arc wall of unique artworks while a title and editable count appear."
    },
    "phases": [
      {
        "id": "phase0",
        "name": {
          "zh": "主卡拉远·作品进场",
          "en": "Hero pullback"
        },
        "colorToken": "phase.sky"
      },
      {
        "id": "phase1",
        "name": {
          "zh": "文字与计数",
          "en": "Title & count"
        },
        "colorToken": "phase.sky"
      },
      {
        "id": "phase2",
        "name": {
          "zh": "弧墙巡航",
          "en": "Arc cruise"
        },
        "colorToken": "phase.sky"
      }
    ]
  },
  "parameters": [
    {
      "path": "composition.scene.title",
      "scope": "effect",
      "name": {
        "zh": "主标题",
        "en": "Headline"
