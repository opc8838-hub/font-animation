{
  "effect": {
    "id": "video-compare",
    "name": {
      "zh": "视频对比",
      "en": "Video Compare"
    },
    "version": "1.0.0",
    "category": "media"
  },
  "runtime": {
    "kind": "iframe-bridge",
    "entry": "video-compare.html?preview=1&embed=1&v=20261015-vcompare12",
    "bridgeVersion": "1.0.0",
    "renderer": "canvas2d"
  },
  "capabilities": {
    "compositionModel": "fixed-video-pair",
    "liveEditorState": true,
    "preview": true,
    "editableTextRows": true,
    "rowFonts": false,
    "inlineIcons": false,
    "customImageAssets": true,
    "videoSources": true,
    "videoTrim": true,
    "sourceAudio": true,
    "audioMixing": true,
    "timeline": true,
    "responsiveCanvas": true,
    "exports": [
      "png",
      "gif",
      "mp4"
    ]
  },
  "behavior": {
    "summary": {
      "zh": "固定 Before / After 双视频对比，Before 始终小于 After。短片及其声音自动循环，预览持续重播，导出在较长的裁剪片段结束时停止。保留独立音轨开关、素材取景和可上传、去白底、缩放的底部 Logo。",
      "en": "A fixed Before / After pair with a smaller Before. Shorter clips and their audio loop; preview repeats and exports end with the longest trimmed clip. Preserves audio switches, framing and a custom footer logo with local white removal and sizing."
    },
    "phases": [
      {
        "id": "compare",
        "name": {
          "zh": "双视频对比",
          "en": "Video comparison"
        },
        "colorToken": "phase.sky"
      },
      {
        "id": "ending",
        "name": {
          "zh": "短片循环",
          "en": "Short clip loops"
        },
        "colorToken": "phase.violet"
      }
    ],
    "audio": {
      "zh": "开启的音轨跟随裁剪区间循环；两路开启时等量混音，导出到最长片段为止。网页有声播放可能需要用户点击播放。",
      "en": "Enabled tracks loop within their trim intervals and mix equally, ending with the longest clip. Audible browser playback may require a user play gesture."
    }
  },
  "parameters": [
    {
      "path": "composition.canvas.preset",
      "scope": "global",
      "type": "enum",
      "name": {
        "zh": "成品画幅",
        "en": "Output preset"
      },
      "values": [
        "1920x1080",
        "1440x1080",
        "1620x1080",
        "1080x1080",
        "1080x1350",
        "1080x1920",
        "custom"
      ]
    },
    {
      "path": "composition.canvas.width",
      "scope": "global",
      "type": "integer",
      "name": {
        "zh": "画布宽度",
        "en": "Canvas width"
      },
      "min": 320,
      "max": 3840,
      "step": 2,
      "unit": "px"
    },
    {
      "path": "composition.canvas.height",
      "scope": "global",
      "type": "integer",
      "name": {
        "zh": "画布高度",
        "en": "Canvas height"
      },
      "min": 320,
      "max": 3840,
      "step": 2,
      "unit": "px"
    },
    {
