      "scope": "global",
      "type": "enum",
      "name": {
        "zh": "视频框比例",
        "en": "Video frame aspect"
      },
      "values": [
        "auto",
        "16:9",
        "9:16"
      ]
    },
    {
      "path": "composition.layout.beforeScale",
      "scope": "global",
      "type": "number",
