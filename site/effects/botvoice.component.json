{
  "effect": {
    "id": "botvoice",
    "name": {
      "zh": "Bot 语音",
      "en": "Bot Voice"
    },
    "version": "1.0.0",
    "category": "media-motion"
  },
  "runtime": {
    "kind": "iframe-bridge",
    "entry": "botvoice.html?preview=1&embed=1&v=20261019-archive4",
    "bridgeVersion": "1.0.0",
    "renderer": "canvas2d"
  },
  "capabilities": {
    "compositionModel": "media",
    "timeline": true,
    "responsiveCanvas": true,
    "exports": [
      "png",
      "gif",
      "mp4"
    ],
    "customImageAssets": true,
    "backgrounds": [
      "color",
      "image",
      "gif",
      "video"
    ],
    "videoTrim": true
  },
  "behavior": {
    "summary": {
      "zh": "手机亮屏、Bot 连续飞行变为流动方块，收成圆点并展开语音。",
      "en": "Phone glow, Bot flight, flowing blocks, and a living voice waveform."
    },
    "phases": [
      {
        "id": "phase0",
        "name": {
          "zh": "手机特写·按键",
          "en": "Press & glow"
        },
        "colorToken": "phase.sky"
      },
      {
        "id": "phase1",
        "name": {
          "zh": "Bot 挤进屏幕",
          "en": "Bot enters"
        },
        "colorToken": "phase.sky"
      },
      {
        "id": "phase2",
        "name": {
          "zh": "12:00 · 猫 · 拉远",
          "en": "Clock & pullback"
        },
        "colorToken": "phase.sky"
      },
      {
        "id": "phase3",
        "name": {
          "zh": "Bot 边飞边变方块",
          "en": "Fly & reshape"
        },
        "colorToken": "phase.sky"
      },
      {
        "id": "phase4",
        "name": {
          "zh": "方块流动",
          "en": "Flowing blocks"
        },
        "colorToken": "phase.sky"
      },
      {
        "id": "phase5",
        "name": {
          "zh": "语音",
          "en": "Voice"
        },
        "colorToken": "phase.sky"
      }
    ]
  },
