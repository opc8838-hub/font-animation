{
  "effect": { "id": "metallic-text", "name": { "zh": "金属流光", "en": "Metallic Text" }, "version": "1.5.0", "category": "type" },
  "runtime": { "kind": "iframe-bridge", "entry": "metallic-text.html?v=20261105-flow1", "bridgeVersion": "1.0.0", "renderer": "webgl2" },
  "capabilities": { "compositionModel": "scene", "editableText": true, "sharedFonts": true, "backgroundMedia": true, "animatedImageBackgrounds": true, "trimmedVideoBackgrounds": true, "responsiveCanvas": true, "timeline": true, "preview": true, "exports": ["png", "gif", "mp4"] },
  "behavior": {
    "summary": { "zh": "支持换行、行距和可见字形对齐。呈现方式：none 直接呈现、scan 逐字横向镭射、laser 沿笔画镭射。写入与光带同时开始；光带在整轮中持续流动，包括文字停留阶段，不减速停住。流动幅度 lightAmplitude 默认 0.28；独立光带速度 lightSpeed 为 0.5–3、步长 0.5，1× 每轮完整流动两周，各档位首尾相接，不改变文字写入速度。sweep 是基础时长；总时长为 (max(启用的写入时长, 基础时长) + 文字停留) / 播放速度。", "en": "Multiline lettering with visible-ink alignment. Reveal modes: immediate (none), horizontal per-letter scan (scan), or stroke writing (laser). Light starts with writing and flows continuously through the entire cycle, including text hold, with no terminal slowdown or freeze. lightAmplitude defaults to 0.28. Independent lightSpeed is 0.5–3 in 0.5 steps; 1x makes two whole laps per composition, ensuring seamless light loops without altering writing speed. sweep is the base duration; total duration is (max(enabled writing duration, base duration) + text hold) / speed." },
    "phases": [
      { "id": "writeDuration", "name": { "zh": "镭射写入（可选）", "en": "Laser writing (optional)" }, "colorToken": "phase.violet" },
      { "id": "sweep", "name": { "zh": "持续流光", "en": "Continuous light" }, "colorToken": "phase.sky" },
      { "id": "hold", "name": { "zh": "文字停留", "en": "Text hold" }, "colorToken": "phase.amber" }
    ]
  },
  "parameters": [
    { "path": "composition.canvas.width", "scope": "global", "type": "integer", "name": { "zh": "画布宽度", "en": "Canvas width" }, "unit": "px", "min": 128, "max": 3840 },
    { "path": "composition.canvas.height", "scope": "global", "type": "integer", "name": { "zh": "画布高度", "en": "Canvas height" }, "unit": "px", "min": 128, "max": 3840 },
    { "path": "composition.scene.text", "scope": "effect", "type": "string", "name": { "zh": "文字内容", "en": "Text" } },
    { "path": "composition.scene.font", "scope": "effect", "type": "string", "name": { "zh": "共享字体", "en": "Shared font" } },
    { "path": "composition.scene.fontSize", "scope": "effect", "type": "number", "name": { "zh": "文字大小", "en": "Text size" }, "min": 0.18, "max": 1.2 },
    { "path": "composition.scene.fontHeight", "scope": "effect", "type": "number", "name": { "zh": "字形高度", "en": "Letter height" }, "min": 0.5, "max": 1.4 },
    { "path": "composition.scene.extraBold", "scope": "effect", "type": "number", "name": { "zh": "额外加粗", "en": "Extra weight" }, "min": 0, "max": 0.04 },
    { "path": "composition.scene.tracking", "scope": "effect", "type": "number", "name": { "zh": "字距", "en": "Letter spacing" }, "min": -0.08, "max": 0.2 },
    { "path": "composition.scene.background", "scope": "effect", "type": "color", "name": { "zh": "背景颜色", "en": "Background" } },
    { "path": "composition.scene.metalTint", "scope": "effect", "type": "color", "name": { "zh": "金属底色", "en": "Metal tint" } },
    { "path": "composition.scene.coolTint", "scope": "effect", "type": "color", "name": { "zh": "冷色反光", "en": "Cool reflection" } },
    { "path": "composition.scene.warmTint", "scope": "effect", "type": "color", "name": { "zh": "暖色反光", "en": "Warm reflection" } },
    { "path": "composition.scene.bevel", "scope": "effect", "type": "number", "name": { "zh": "金属边缘", "en": "Metal edge" }, "min": 0, "max": 0.2 },
    { "path": "composition.scene.shine", "scope": "effect", "type": "number", "name": { "zh": "反光强度", "en": "Reflection strength" }, "min": 0, "max": 1.5 },
    { "path": "composition.scene.lightWidth", "scope": "effect", "type": "number", "name": { "zh": "光带宽度", "en": "Band width" }, "min": 0.08, "max": 0.6 },
    { "path": "composition.scene.lightAmplitude", "scope": "effect", "type": "number", "name": { "zh": "流动幅度", "en": "Travel amplitude" }, "min": 0.08, "max": 0.42, "step": 0.01, "default": 0.28 },
    { "path": "composition.scene.lightSpeed", "scope": "effect", "type": "number", "name": { "zh": "光带速度", "en": "Light speed" }, "unit": "×", "min": 0.5, "max": 3, "step": 0.5, "default": 1 },
    { "path": "composition.scene.direction", "scope": "effect", "type": "enum", "name": { "zh": "流动方向", "en": "Direction" }, "values": ["forward", "reverse"] },
    { "path": "composition.scene.revealMode", "scope": "effect", "type": "enum", "name": { "zh": "呈现方式", "en": "Reveal style" }, "values": ["none", "scan", "laser"], "default": "none" },
    { "path": "composition.scene.writeDuration", "scope": "effect", "type": "number", "name": { "zh": "镭射写入时长", "en": "Laser writing duration" }, "unit": "s", "min": 0.3, "max": 10, "default": 2.4 },
    { "path": "composition.scene.lineHeight", "scope": "effect", "type": "number", "name": { "zh": "行距", "en": "Line spacing" }, "min": 1.1, "max": 2.5, "default": 1.35 },
    { "path": "composition.scene.sweep", "scope": "effect", "type": "number", "name": { "zh": "基础时长", "en": "Base duration" }, "unit": "s", "min": 0.5, "max": 10 },
    { "path": "composition.scene.hold", "scope": "effect", "type": "number", "name": { "zh": "文字停留", "en": "Text hold" }, "unit": "s", "min": 0, "max": 4 },
    { "path": "composition.scene.speed", "scope": "effect", "type": "number", "name": { "zh": "播放速度", "en": "Playback speed" }, "min": 0.25, "max": 2 },
    { "path": "composition.scene.positionX", "scope": "effect", "type": "number", "name": { "zh": "水平位置", "en": "Horizontal position" }, "unit": "%", "min": -40, "max": 40, "default": 0 },
    { "path": "composition.scene.positionY", "scope": "effect", "type": "number", "name": { "zh": "垂直位置", "en": "Vertical position" }, "unit": "%", "min": -40, "max": 40, "default": 0 },
    { "path": "composition.scene.alignment", "scope": "effect", "type": "enum", "name": { "zh": "对齐", "en": "Alignment" }, "values": ["left", "center", "right"], "default": "center" },
    { "path": "composition.scene.backgroundMedia.url", "scope": "asset", "type": "string", "name": { "zh": "背景素材", "en": "Background source" } },
    { "path": "composition.scene.backgroundMedia.name", "scope": "asset", "type": "string", "name": { "zh": "素材名称", "en": "Source name" } },
    { "path": "composition.scene.backgroundMedia.fileType", "scope": "asset", "type": "string", "name": { "zh": "素材格式", "en": "Source MIME type" } },
    { "path": "composition.scene.backgroundMedia.videoStart", "scope": "asset", "type": "number", "name": { "zh": "视频开始", "en": "Video start" }, "unit": "s" },
    { "path": "composition.scene.backgroundMedia.videoEnd", "scope": "asset", "type": "number", "name": { "zh": "视频结束", "en": "Video end" }, "unit": "s" },
    { "path": "composition.scene.backgroundMedia.cropX", "scope": "asset", "type": "number", "name": { "zh": "取景水平位置", "en": "Crop horizontal position" }, "min": 0, "max": 1 },
    { "path": "composition.scene.backgroundMedia.cropY", "scope": "asset", "type": "number", "name": { "zh": "取景垂直位置", "en": "Crop vertical position" }, "min": 0, "max": 1 },
    { "path": "composition.scene.backgroundMedia.cropZoom", "scope": "asset", "type": "number", "name": { "zh": "背景缩放", "en": "Background zoom" }, "min": 1, "max": 4 }
  ]
}
