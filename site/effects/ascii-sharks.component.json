{
  "effect": {
    "id": "ascii-sharks",
    "name": {
      "zh": "字符海洋",
      "en": "ASCII Ocean"
    },
    "version": "1.0.0",
    "category": "graphic"
  },
  "runtime": {
    "kind": "iframe-bridge",
    "entry": "ascii-sharks.html?preview=1&embed=1&v=20261020-ocean-release1",
    "bridgeVersion": "1.0.0",
    "renderer": "canvas2d"
  },
  "capabilities": {
    "compositionModel": "media",
    "timeline": true,
    "responsiveCanvas": true,
    "exports": [
      "png",
      "gif",
      "mp4"
    ],
    "customImageAssets": true,
    "backgrounds": [
      "color",
      "image",
      "gif",
      "video"
    ],
    "videoTrim": true
  },
  "behavior": {
    "summary": {
      "zh": "字符海洋在白底细网格中独立巡游，身体随转向弯曲，灰色字符方格呈现明暗。",
      "en": "ASCII Ocean swim independently over a light grid, with articulated bodies and shaded character tiles."
    },
    "phases": [
      {
        "id": "swim",
        "name": {
          "zh": "连续巡游",
          "en": "Continuous swim"
        },
        "colorToken": "phase.sky"
      }
    ]
  },
  "parameters": [
    {
      "path": "composition.motion.speed",
      "scope": "effect",
      "name": {
        "zh": "整体速度",
        "en": "Overall speed"
      },
      "type": "number",
      "minimum": 0.25,
      "maximum": 3
    },
    {
      "path": "composition.motion.swim",
      "scope": "effect",
      "name": {
        "zh": "巡游一轮",
        "en": "Swim cycle"
      },
      "type": "number",
      "minimum": 8,
      "maximum": 60
    },
    {
      "path": "composition.scene.size",
      "scope": "effect",
      "name": {
        "zh": "主体大小",
        "en": "Subject size"
      },
      "type": "number",
      "minimum": 0.3,
      "maximum": 1.4
    },
    {
      "path": "composition.scene.density",
      "scope": "effect",
      "name": {
        "zh": "字符密度",
        "en": "Character density"
      },
      "type": "number",
      "minimum": 0.6,
      "maximum": 1.6
    },
    {
      "path": "composition.scene.fish",
      "scope": "effect",
      "name": {
        "zh": "小鱼数量",
        "en": "Small fish"
      },
      "type": "number",
      "minimum": 0,
      "maximum": 420
    },
    {
      "path": "composition.scene.dots",
      "scope": "effect",
      "name": {
        "zh": "海水微粒",
        "en": "Water particles"
      },
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    {
      "path": "composition.scene.amplitude",
      "scope": "effect",
      "name": {
        "zh": "摆尾幅度",
        "en": "Tail amplitude"
