{
  "effect": {
    "id": "animalwave",
    "name": {
      "zh": "动物浪潮",
      "en": "Animal Wave"
    },
    "version": "1.0.0",
    "category": "media-motion"
  },
  "runtime": {
    "kind": "iframe-bridge",
    "entry": "animalwave.html?preview=1&embed=1&v=20261019-archive4",
    "bridgeVersion": "1.0.0",
    "renderer": "canvas2d"
  },
  "capabilities": {
    "compositionModel": "media",
    "timeline": true,
    "responsiveCanvas": true,
    "exports": [
      "png",
      "gif",
      "mp4"
    ],
    "customImageAssets": true,
    "backgrounds": [
      "color",
      "image",
      "gif",
      "video"
    ],
    "videoTrim": true
  },
  "behavior": {
    "summary": {
      "zh": "头像依次递增，加速连接成波浪，最后显现品牌。",
      "en": "Avatars arrive, accelerate into a wave, and reveal the brand."
    },
    "phases": [
      {
        "id": "phase0",
        "name": {
          "zh": "单只亮相",
          "en": "First arrival"
        },
        "colorToken": "phase.sky"
      },
      {
        "id": "phase1",
        "name": {
          "zh": "头像递增",
          "en": "New friends"
        },
        "colorToken": "phase.sky"
      },
      {
        "id": "phase2",
        "name": {
          "zh": "加速成浪",
          "en": "Rush into wave"
        },
        "colorToken": "phase.sky"
      },
      {
        "id": "phase3",
        "name": {
          "zh": "波浪巡航",
          "en": "Wave cruise"
        },
        "colorToken": "phase.sky"
      },
      {
        "id": "phase4",
        "name": {
          "zh": "品牌收尾",
          "en": "Brand reveal"
        },
        "colorToken": "phase.sky"
      }
    ]
  },
  "parameters": [
