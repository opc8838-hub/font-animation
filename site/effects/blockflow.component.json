{
  "effect": {
    "id": "blockflow",
    "name": {
      "zh": "方块流动",
      "en": "Block Flow"
    },
    "version": "1.0.0",
    "category": "media-motion"
  },
  "runtime": {
    "kind": "iframe-bridge",
    "entry": "blockflow.html?preview=1&embed=1&v=20261019-block1",
    "bridgeVersion": "1.0.0",
    "renderer": "canvas2d"
  },
  "capabilities": {
    "compositionModel": "media",
    "timeline": true,
    "responsiveCanvas": true,
    "exports": [
      "png",
      "gif",
      "mp4"
    ],
    "customImageAssets": true,
    "backgrounds": [
      "color",
      "image",
      "gif",
      "video"
    ],
    "videoTrim": true
  },
  "behavior": {
    "summary": {
      "zh": "图标汇成蓝色方块，方块起伏流动后收拢；可继续添加方块并替换每个图标。",
      "en": "Icons become blue blocks, flow in a wave, and gather again; add blocks and replace their icons."
    },
    "phases": [
      {
        "id": "phase0",
        "name": {
          "zh": "图标汇聚·变方块",
          "en": "Icons to blocks"
        },
        "colorToken": "phase.sky"
      },
      {
        "id": "phase1",
        "name": {
          "zh": "方块流动",
          "en": "Flowing blocks"
        },
        "colorToken": "phase.sky"
      },
      {
        "id": "phase2",
        "name": {
          "zh": "收拢归一",
          "en": "Gather"
        },
        "colorToken": "phase.sky"
      }
    ]
  },
  "parameters": [
