{
  "effect": {
    "id": "patentwall",
    "name": {
      "zh": "专利墙",
      "en": "Patent Wall"
    },
    "version": "1.0.0",
    "category": "media-motion"
  },
  "runtime": {
    "kind": "iframe-bridge",
    "entry": "patentwall.html?preview=1&embed=1",
    "bridgeVersion": "1.0.0",
    "renderer": "canvas2d"
  },
  "capabilities": {
    "compositionModel": "media",
    "timeline": true,
    "responsiveCanvas": true,
    "exports": [
      "png",
      "gif",
      "mp4"
    ],
    "customImageAssets": true,
    "backgrounds": [
      "color",
      "image",
      "gif",
      "video"
    ],
    "videoTrim": true
  },
  "behavior": {
    "summary": {
      "zh": "Logo 翻转、证书展开，逐张特写后拉远形成滚动专利墙。",
      "en": "Flip a logo into certificates, focus each card, and pull back into a drifting wall."
    },
    "phases": [
      {
        "id": "phase0",
        "name": {
          "zh": "Logo 翻转",
          "en": "Logo flip"
        },
        "colorToken": "phase.sky"
      },
      {
        "id": "phase1",
        "name": {
          "zh": "展开·右滑·特写 1",
          "en": "Spread & focus"
        },
        "colorToken": "phase.sky"
      },
      {
        "id": "phase2",
        "name": {
          "zh": "特写 2",
          "en": "Close-up 2"
        },
        "colorToken": "phase.sky"
      },
      {
        "id": "phase3",
        "name": {
          "zh": "特写 3",
          "en": "Close-up 3"
        },
        "colorToken": "phase.sky"
      },
      {
        "id": "phase4",
        "name": {
          "zh": "特写 4",
          "en": "Close-up 4"
        },
        "colorToken": "phase.sky"
      },
      {
        "id": "phase5",
        "name": {
          "zh": "拉远·专利墙",
          "en": "Patent wall"
        },
        "colorToken": "phase.sky"
      }
    ]
  },
  "parameters": [
    {
      "path": "composition.motion.phase0",
      "scope": "effect",
      "name": {
        "zh": "Logo 翻转时长",
        "en": "Flip duration"
      },
      "type": "number",
      "minimum": 0.15,
      "maximum": 20,
      "unit": "s"
    },
    {
      "path": "composition.motion.phase1",
      "scope": "effect",
      "name": {
        "zh": "展开·右滑·特写 1时长",
        "en": "Spread & focus duration"
      },
      "type": "number",
      "minimum": 0.15,
      "maximum": 20,
      "unit": "s"
    },
    {
      "path": "composition.motion.phase2",
      "scope": "effect",
      "name": {
        "zh": "特写 2时长",
        "en": "Close-up 2 duration"
      },
      "type": "number",
      "minimum": 0.15,
      "maximum": 20,
      "unit": "s"
    },
    {
      "path": "composition.motion.phase3",
      "scope": "effect",
      "name": {
        "zh": "特写 3时长",
        "en": "Close-up 3 duration"
      },
      "type": "number",
      "minimum": 0.15,
      "maximum": 20,
      "unit": "s"
    },
    {
      "path": "composition.motion.phase4",
      "scope": "effect",
      "name": {
        "zh": "特写 4时长",
        "en": "Close-up 4 duration"
      },
      "type": "number",
      "minimum": 0.15,
      "maximum": 20,
      "unit": "s"
    },
    {
      "path": "composition.motion.phase5",
      "scope": "effect",
      "name": {
        "zh": "拉远·专利墙时长",
        "en": "Wall duration"
      },
      "type": "number",
      "minimum": 0.15,
      "maximum": 20,
      "unit": "s"
    },
    {
      "path": "composition.scene.textColor",
