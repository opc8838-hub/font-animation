{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opc8838-hub.github.io/font-animation/schemas/cellmotion-component-v1.schema.json",
  "title": "CellMotion Component Manifest v1",
  "type": "object",
  "required": ["schemaVersion", "effect", "runtime", "composition"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "effect": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "object" },
        "version": { "type": "string" }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["kind", "entry", "bridgeVersion"],
      "properties": {
        "kind": { "const": "iframe-bridge" },
        "entry": { "type": "string" },
        "bridgeVersion": { "const": "1.0.0" }
      }
    },
    "composition": {
      "type": "object",
      "anyOf": [
        { "required": ["canvas", "motion", "rows"] },
        { "required": ["canvas", "motion", "cards"] },
        { "required": ["canvas", "motion", "scene"] },
        {
          "required": ["effect", "version", "settings", "assets"],
          "properties": {
            "effect": { "const": "curvedgallery" },
            "version": { "enum": [1, 2] },
            "settings": { "type": "object", "required": ["width", "height"], "properties": { "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } } },
            "assets": { "type": "array", "items": { "type": "object" } }
          }
        },
        {
          "required": [
            "effect",
            "version",
            "canvas",
            "layout",
            "export",
            "rows"
          ],
          "properties": {
            "effect": {
              "const": "video-compare"
            },
            "version": {
              "const": 1
            },
            "canvas": {
              "type": "object",
              "required": [
                "width",
                "height"
              ],
              "properties": {
                "width": {
                  "type": "integer",
                  "minimum": 320,
                  "maximum": 3840,
                  "multipleOf": 2
                },
                "height": {
                  "type": "integer",
                  "minimum": 320,
                  "maximum": 3840,
                  "multipleOf": 2
                }
              }
            },
            "layout": {
              "type": "object"
            },
            "logo": {
              "type": [
                "object",
                "null"
              ],
              "required": [
                "kind",
                "url",
                "name",
                "background",
                "color",
                "tolerance"
              ],
              "properties": {
                "kind": {
                  "const": "image"
                },
                "url": {
                  "type": "string",
                  "pattern": "^data:image/png;base64,"
                },
                "name": {
                  "type": "string"
                },
                "background": {
                  "enum": [
                    "keep",
                    "remove-white"
                  ]
                },
                "color": {
                  "enum": [
                    "original",
                    "black",
                    "white"
                  ]
                },
                "tolerance": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 100
                }
              }
            },
            "export": {
              "type": "object"
            },
            "rows": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "text",
                  "caption",
                  "audioEnabled",
                  "media"
                ],
                "properties": {
                  "id": {
                    "enum": [
                      "before",
                      "after"
                    ]
                  },
                  "text": {
                    "type": "string"
                  },
                  "caption": {
                    "type": "string"
                  },
                  "audioEnabled": {
                    "type": "boolean"
                  },
                  "media": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "required": [
                      "kind",
                      "url"
                    ],
                    "properties": {
                      "kind": {
                        "const": "video"
                      },
                      "url": {
                        "type": "string",
                        "pattern": "^data:video/"
                      },
                      "trimStart": {
                        "type": "number",
                        "minimum": 0
                      },
                      "trimEnd": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  }
                }
              },
              "prefixItems": [
                {
                  "properties": {
                    "id": {
                      "const": "before"
                    }
                  }
                },
                {
                  "properties": {
                    "id": {
                      "const": "after"
                    }
                  }
                }
              ]
            }
          }
        }
      ],
      "properties": {
        "canvas": { "type": "object" },
        "typography": { "type": "object" },
        "motion": { "type": "object" },
        "rows": { "type": "array", "items": { "type": "object" } },
        "cards": { "type": "array", "items": { "type": "object" } },
        "scene": { "type": "object" }
      }
    },
    "parameterDefinitions": { "type": "array" },
    "assets": { "type": "object" },
    "presentation": { "type": "object" }
  },
  "additionalProperties": true
}
